{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["./redesign/types/ignite.d.ts"]
  },
  "include": [
    "redesign/types/**/*.d.ts",
    "redesign/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
